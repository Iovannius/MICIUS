@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(NOT WIN32 AND (NOT MICIUS_FIND_COMPONENTS OR "gguf" IN_LIST MICIUS_FIND_COMPONENTS OR "text" IN_LIST MICIUS_FIND_COMPONENTS OR "session" IN_LIST MICIUS_FIND_COMPONENTS))
    find_dependency(OpenSSL COMPONENTS Crypto)
endif()
if(@MICIUS_ENABLE_TEXT@ AND (NOT MICIUS_FIND_COMPONENTS OR "text" IN_LIST MICIUS_FIND_COMPONENTS OR "session" IN_LIST MICIUS_FIND_COMPONENTS))
    find_dependency(PkgConfig)
    pkg_check_modules(MICIUS_PCRE2 REQUIRED IMPORTED_TARGET libpcre2-8)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MICIUSTargets.cmake")
foreach(component IN LISTS MICIUS_FIND_COMPONENTS)
    if(TARGET MICIUS::${component})
        set(MICIUS_${component}_FOUND TRUE)
    else()
        set(MICIUS_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(MICIUS)
